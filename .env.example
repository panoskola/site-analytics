# Copy to .env and fill in:  cp .env.example .env
# Never commit .env — it is in .gitignore.

# Free hostname from duckdns.org pointing to the VM's public IP
UMAMI_DOMAIN=panoskola-stats.duckdns.org

# Generate each with:  openssl rand -hex 32
POSTGRES_PASSWORD=change-me
APP_SECRET=change-me

# Pin a tested version after the first deploy (e.g. a specific release tag)
UMAMI_VERSION=latest

# DuckDNS (used by scripts/duckdns-update.sh)
DUCKDNS_SUBDOMAIN=panoskola-stats
DUCKDNS_TOKEN=change-me
